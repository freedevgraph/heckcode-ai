{
  "name": "heckcode",
  "version": "0.1.0",
  "description": "A highly modular AI coding agent with human-in-the-loop, setup wizard CLI, and multiple AI providers",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "heckcode": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "modular"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.24.1",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "inquirer": "^14.0.2",
    "openai": "^6.49.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
